# 复制为服务器上的 .env（/opt/etymology/deploy/.env，不入仓库）
# ── 会话密钥：必配，openssl rand -hex 32 生成；不配则重启后所有人掉线 ──
SESSION_SECRET=change-me

# ── 数据库（容器内路径，卷持久化）──
DB_PATH=/data/etymology.db

# ── 站点地址（HTTPS 配好后改 https://565734.xyz）──
APP_URL=http://124.220.110.165

# ── SMTP 发信（QQ 邮箱：设置→账户→开启 SMTP→拿授权码）。不配则验证码走服务器日志兜底 ──
#SMTP_HOST=smtp.qq.com
#SMTP_PORT=465
#SMTP_USER=yourname@qq.com
#SMTP_PASS=你的授权码
#MAIL_FROM=林序 <yourname@qq.com>

# ── GitHub OAuth App（https://github.com/settings/developers 创建，回调填
#    http://124.220.110.165/api/auth/github/callback）。不配则隐藏 GitHub 登录按钮 ──
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
